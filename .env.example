# ──────────────────────────────────────────────────────────────────────────
#  DE DÓNDE SALE EL CATÁLOGO
#
#  Con estas dos variables cargadas, el sitio lee los modelos, las fotos y las
#  fichas del Nova de la concesionaria, y el cliente los maneja desde el panel
#  (Web → Catálogo). Sin ellas, sale de los archivos generados del repo, que es
#  como venía funcionando.
#
#  Van cargadas en Vercel, no en un archivo: acá quedan documentadas. Sacarlas
#  es la vuelta atrás si algo sale mal, y no hace falta desplegar nada.
# ──────────────────────────────────────────────────────────────────────────

# Base de la API de Nova, sin barra al final.
NOVA_API_URL=https://nova-api-xxxxx.run.app

# Token del catálogo de la empresa. Lo genera el script de carga inicial
# (apps/api/scripts/importar-catalogo-web.ts) y lo imprime al terminar.
NOVA_CATALOG_TOKEN=wc_xxxxxxxxxxxxxxxx
